<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Brama.Sample.Api</RootNamespace>
        <IsPackable>false</IsPackable>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Brama\Brama.csproj" />
        <ProjectReference Include="..\..\src\Brama.SourceGenerator\Brama.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!--
      A packaged consumer gets this via buildTransitive/. This sample references the generator as a
      project, which does not flow targets, so it imports them by path.
    -->
    <Import Project="../../src/Brama.SourceGenerator/build/Brama.Contracts.targets" />

</Project>
